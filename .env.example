# EmeHub — configuration
#
# Copy to .env and fill in. Every variable is prefixed EMEHUB_ so the hub can run
# alongside QAgent (QAGENT_*) on the same host.
#
# Nothing here is read yet — the application does not exist. This file documents the
# intended configuration surface so Phase 1 has a target. See docs/ROADMAP.md.


# ── Secrets ──────────────────────────────────────────────────────────────────
# These are TWO DIFFERENT SECRETS and must never be set to the same value.
# See docs/adr/0005-secret-and-key-management.md.
#
# The application refuses to start if either is missing. There is deliberately no
# generated-on-boot fallback: a generated encryption key silently produces rows that
# cannot be decrypted after the next restart.

# Signs access tokens. Rotatable — worst case, everyone re-authenticates.
#   generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
EMEHUB_JWT_SECRET=

# Encrypts credentials at rest. LOSS IS UNRECOVERABLE — back this up.
# Rotating it is a re-key operation over the data, not a config change.
#   generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
EMEHUB_ENCRYPTION_KEY=


# ── Database ─────────────────────────────────────────────────────────────────
# Port 5457 avoids QAgent's default (5456).
EMEHUB_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5457/emehub
EMEHUB_DB_PORT=5457


# ── Ports ────────────────────────────────────────────────────────────────────
# Chosen not to clash with QAgent (api 8787, web 5174) or DAgent (web 3000).
EMEHUB_API_PORT=8790
EMEHUB_WEB_PORT=5180


# ── Tokens & cookies ─────────────────────────────────────────────────────────
EMEHUB_ACCESS_TOKEN_TTL_MINUTES=15
EMEHUB_REFRESH_TOKEN_TTL_DAYS=30

# Lifetime of a run-scoped Claude-credential grant (ADR 0009), in MINUTES.
#
# An agent's background run has no browser, so it cannot mint an agent token, and
# a 15-minute access token expires long before a long run does. A grant covers
# that gap and reaches ONLY the three /credentials/claude/* endpoints an agent
# uses; it dies with its hub session and cannot renew itself.
#
# Hard cap 1440. Out of range is a startup failure rather than a silent clamp, so
# a value meant as hours (4) is safe to spot, but 14400 refuses to boot.
EMEHUB_AGENT_GRANT_TTL_MINUTES=240

# Set to true in any deployment reachable over HTTPS.
EMEHUB_COOKIE_SECURE=false

# Cookie domain. Leave empty for a localhost-only stack.
#
# REQUIRED for the sign-in hand-off (ADR 0008). Set it to the parent domain the
# hub and its agents share — e.g. .chuongnd.click for hub.chuongnd.click plus
# qagent.chuongnd.click. That is what lets an agent's browser send the refresh
# cookie to POST /auth/agent-token. Without it the hand-off cannot work and each
# app keeps a separate login.
#
# The agents must be siblings under this domain. An agent on an unrelated
# registrable domain cannot use the hand-off at all — see ADR 0008.
EMEHUB_COOKIE_DOMAIN=

# Path the auth cookies are scoped to. The SPA reaches the API through an /api
# prefix (nginx strips it, the Vite dev proxy rewrites it), so a cookie scoped
# to /auth would never come back on /api/auth/refresh. Leave as / unless the hub
# is served without the prefix.
EMEHUB_COOKIE_PATH=/

# Origins allowed to call the API cross-origin *with credentials*. The hub's own
# SPA is same-origin, so this is only about agents: the hand-off has the agent's
# browser POST to /auth/agent-token from its own origin, and that needs the
# origin listed here as well as the cookie domain above.
#
# JSON array or a plain comma-separated list; empty means "the hub's dev server
# only". Match the scheme and host exactly — https://qagent.chuongnd.click is a
# different origin from http://qagent.chuongnd.click.
EMEHUB_CORS_ORIGINS=


# ── Registered agents ────────────────────────────────────────────────────────
# Audiences the hub will mint tokens for. An agent with no URL here is not
# registered, cannot receive a token, and is reported as not launchable rather
# than rendering a dead button. See docs/INTEGRATION.md §2.
#
# Set these to the deployed origins, e.g. https://qagent.chuongnd.click, or to a
# path (/qagent) when the agent is mounted behind the suite's front door — a
# same-origin path is hand-off-ready by construction and needs neither the cookie
# domain above nor a CORS entry.
#
# Note that a URL alone only makes an agent *registered*. The Launch button
# additionally needs the hand-off to be able to work, which for an agent on its
# own origin means that origin sitting under EMEHUB_COOKIE_DOMAIN — otherwise
# GET /agents reports `domain_mismatch` and the button says why instead of
# offering a launch that fails. http://localhost:3000 with a real cookie domain
# set is exactly that case.
#
# Both agents are mounted as paths behind the suite's front door (edge/), so the
# values below are paths and not origins. DAgent's mount additionally needs its
# container built with a matching DAGENT_BASE_PATH — see dagent/README.md.
#
# DAgent still does not exchange a hub token for a session, so a launch reaches
# its own login form (docs/SSO-HANDOFF-PLAN.md §5, docs/DAGENT-HANDOFF.md §4).
# That is navigation without single sign-on — worth having, and worth knowing
# about.
EMEHUB_AGENT_QAGENT_URL=/qagent
EMEHUB_AGENT_DAGENT_URL=/dagent


# ── First admin ──────────────────────────────────────────────────────────────
# Seeded on first boot only. Change the password immediately after.
EMEHUB_ADMIN_EMAIL=
EMEHUB_ADMIN_PASSWORD=


# ── Misc ─────────────────────────────────────────────────────────────────────
# debug | info | warning | error
EMEHUB_LOG_LEVEL=info

# Where the hub keeps repository clones, emitted knowledge artefacts and the
# materialised Claude credential a build runs under.
#
# TREAT AS SENSITIVE (ADR 0007). For the duration of a build this directory
# holds a decrypted .credentials.json. It is chmod 0700/0600 by the API, but do
# not make it a world-readable mount and do not copy it around.
EMEHUB_WORKSPACE_DIR=./workspace


# ── Knowledge builds ─────────────────────────────────────────────────────────
# The hub clones the repository and runs `project-bootstrap` through the Claude
# CLI itself (docs/adr/0007-knowledge-builds-run-on-the-hub.md). The API image
# ships git, Node 20 and @anthropic-ai/claude-code for exactly this.

# How many builds may run at once, process-wide. A build is minutes long, clones
# a repository and runs a CLI process, so this is what stops one member from
# starving the workspace. Requests over the cap queue with the row left in
# `indexing`; they are never dropped. Raise it only with the container's CPU and
# disk in mind.
EMEHUB_KNOWLEDGE_BUILD_CONCURRENCY=2

# The Claude Code CLI executable, and the model every hub-run call uses. The
# model matches QAgent's default so both stacks build comparable knowledge.
EMEHUB_CLAUDE_BIN=claude
EMEHUB_CLAUDE_MODEL=claude-sonnet-5

# Budgets, in seconds. A build traverses a whole repository, so it gets its own
# (much longer) ceiling; exceeding either lands the row in `error`.
EMEHUB_CLAUDE_TIMEOUT_S=300
EMEHUB_CLAUDE_BOOTSTRAP_TIMEOUT_S=1200
EMEHUB_CLONE_TIMEOUT_S=180

# Where <skill>/SKILL.md lives. Empty means the repo's own skills/ directory
# (/app/skills in the container). Override only for a non-standard layout.
EMEHUB_SKILLS_DIR=
