# EmeHub — configuration
#
# Copy to .env and fill in. Every variable is prefixed EMEHUB_ so the hub can run
# alongside QAgent (QAGENT_*) on the same host.
#
# Nothing here is read yet — the application does not exist. This file documents the
# intended configuration surface so Phase 1 has a target. See docs/ROADMAP.md.


# ── Secrets ──────────────────────────────────────────────────────────────────
# These are TWO DIFFERENT SECRETS and must never be set to the same value.
# See docs/adr/0005-secret-and-key-management.md.
#
# The application refuses to start if either is missing. There is deliberately no
# generated-on-boot fallback: a generated encryption key silently produces rows that
# cannot be decrypted after the next restart.

# Signs access tokens. Rotatable — worst case, everyone re-authenticates.
#   generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
EMEHUB_JWT_SECRET=

# Encrypts credentials at rest. LOSS IS UNRECOVERABLE — back this up.
# Rotating it is a re-key operation over the data, not a config change.
#   generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
EMEHUB_ENCRYPTION_KEY=


# ── Database ─────────────────────────────────────────────────────────────────
# Port 5457 avoids QAgent's default (5456).
EMEHUB_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5457/emehub
EMEHUB_DB_PORT=5457


# ── Ports ────────────────────────────────────────────────────────────────────
# Chosen not to clash with QAgent (api 8787, web 5174) or DAgent (web 3000).
EMEHUB_API_PORT=8790
EMEHUB_WEB_PORT=5180


# ── Tokens & cookies ─────────────────────────────────────────────────────────
EMEHUB_ACCESS_TOKEN_TTL_MINUTES=15
EMEHUB_REFRESH_TOKEN_TTL_DAYS=30

# Set to true in any deployment reachable over HTTPS.
EMEHUB_COOKIE_SECURE=false

# Cookie domain. Leave empty for localhost. For subdomain deployment
# (hub.emesoft.net / qa.emesoft.net) set to .emesoft.net.
EMEHUB_COOKIE_DOMAIN=


# ── Registered agents ────────────────────────────────────────────────────────
# Audiences the hub will mint tokens for, and where the UI links each agent.
# An agent not listed here cannot receive a token. See docs/INTEGRATION.md §2.
EMEHUB_AGENT_QAGENT_URL=http://localhost:5174
EMEHUB_AGENT_DAGENT_URL=http://localhost:3000


# ── First admin ──────────────────────────────────────────────────────────────
# Seeded on first boot only. Change the password immediately after.
EMEHUB_ADMIN_EMAIL=
EMEHUB_ADMIN_PASSWORD=


# ── Misc ─────────────────────────────────────────────────────────────────────
# debug | info | warning | error
EMEHUB_LOG_LEVEL=info

# Where the hub keeps materialised credentials and cloned state.
EMEHUB_WORKSPACE_DIR=./workspace
