# D-Agent's containerised deployment — configuration.
#
#   cp dagent/.env.example dagent/.env
#
# Read by `docker compose -f dagent/docker-compose.yml` only. Every variable is
# prefixed DAGENT_ so it cannot collide with the hub's EMEHUB_* file; compose maps
# them onto the names the application itself reads (APP_ACCESS_PASSWORD,
# SETTINGS_ENC_KEY, DATABASE_URL …).
#
# This file configures a *deployment of a sibling application*. The application's
# own configuration surface is documented in
# ../../ticket-executor/ticket-executor/.env.example — read that for what each
# setting means to the app. Only the deployment-relevant subset is here.


# ── Required ─────────────────────────────────────────────────────────────────
# The container refuses to start without both. That is stricter than D-Agent's
# own defaults on purpose: this deployment publishes a port, and both of the
# app's fallbacks (no auth gate; encryption key derived from DATABASE_URL) are
# wrong for anything reachable beyond one developer's loopback.

# Shared login password for the whole app — there are no user accounts.
DAGENT_APP_ACCESS_PASSWORD=

# AES-256-GCM key encrypting the provider PAT at rest. Losing it means every
# stored PAT must be re-entered in Settings; it does not lose run history.
#   generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DAGENT_SETTINGS_ENC_KEY=


# ── The hub ──────────────────────────────────────────────────────────────────
# Where this container reaches the EmeHub API. host.docker.internal is the host
# as seen from inside a container, and 8790 is the hub's published api port — the
# two stacks do not share a network for this, they use the host's loopback.
#
# Include the API prefix the hub is served under. Straight at the api container
# there is none, so the bare origin is right; through the suite's front door it
# would be `https://app.<domain>/api`.
#
# Leave empty and D-Agent's Settings page reports the hub as not configured,
# which is honest, rather than failing a sync with a fetch error.
#
# The other half of this lives in the hub's own .env: EMEHUB_AGENT_DAGENT_URL has
# to point back at this deployment, or the hub's Launch button stays disabled.
DAGENT_HUB_URL=http://host.docker.internal:8790


# ── Ports ────────────────────────────────────────────────────────────────────
# 3000 is D-Agent's own default. 5458 continues the suite's database series
# (q-agent 5456, emehub 5457) and avoids the 5438 D-Agent's README suggests for a
# host Postgres, so both can run at once.
DAGENT_WEB_PORT=3000
DAGENT_DB_PORT=5458


# ── Database ─────────────────────────────────────────────────────────────────
# Credentials for the bundled Postgres. The connection string itself is assembled
# in docker-compose.yml — these are its parts, so the values here and the
# database the app talks to cannot drift.
DAGENT_DB_USER=dagent
DAGENT_DB_PASSWORD=dagent
DAGENT_DB_NAME=dagent


# ── Optional ─────────────────────────────────────────────────────────────────
# Default provider when no Settings row exists yet:
#   azure-devops | github | jira | gitlab   (only azure-devops is fully wired)
DAGENT_TICKET_PROVIDER=azure-devops

# Extra folder scanned for skills, on top of the image's own /root/.claude/skills.
DAGENT_CLAUDE_SKILLS_DIR=

# Fallback Azure DevOps project for org-wide repo/PR lookups when it cannot be
# resolved from the repository.
DAGENT_CLAUDE_DEFAULT_PROJECT=
